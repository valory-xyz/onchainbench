,\"type\":\"error\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"to\",\"type\":\"address\"}],\"name\":\"NotACallToTheSafeItself\",\"type\":\"error\"},{\"inputs\":[{\"internalType\":\"uint8\",\"name\":\"operation\",\"type\":\"uint8\"}],\"name\":\"NotAPlainCall\",\"type\":\"error\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"caller\",\"type\":\"address\"}],\"name\":\"NotAnOwner\",\"type\":\"error\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"gasPrice\",\"type\":\"uint256\"}],\"name\":\"PaysAGasRefund\",\"type\":\"error\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"address\",\"name\":\"safe\",\"type\":\"address\"},{\"indexed\":true,\"internalType\":\"bytes32\",\"name\":\"safeTxHash\",\"type\":\"bytes32\"},{\"indexed\":false,\"internalType\":\"uint256\",\"name\":\"nonce\",\"type\":\"uint256\"},{\"indexed\":true,\"internalType\":\"address\",\"name\":\"requestedBy\",\"type\":\"address\"}],\"name\":\"Cosigned\",\"type\":\"event\"},{\"inputs\":[{\"internalType\":\"contract ISafe\",\"name\":\"safe\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"to\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"value\",\"type\":\"uint256\"},{\"internalType\":\"bytes\",\"name\":\"data\",\"type\":\"bytes\"},{\"internalType\":\"uint8\",\"name\":\"operation\",\"type\":\"uint8\"},{\"internalType\":\"uint256\",\"name\":\"safeTxGas\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"baseGas\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"gasPrice\",\"type\":\"uint256\"},{\"internalType\":\"address\",\"name\":\"gasToken\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"refundReceiver\",\"type\":\"address\"}],\"name\":\"cosign\",\"outputs\":[{\"internalType\":\"bytes32\",\"name\":\"safeTxHash\",\"type\":\"bytes32\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\"}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{},\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{},\"notice\":\"A co-signer for a team Safe it is an owner of. Any other owner of that Safe hands it a Safe transaction's fields; it recomputes the transaction's hash at the Safe's current nonce and approves it on the Safe (`approveHash`), so the caller holds a second approval. Its policy looks only at the transaction's shape, never at what the call does: a plain call (no delegatecall) from the Safe to itself, carrying no value and paying no gas refund. A call of that shape moves none of the Safe's native balance or tokens by itself, but it can change who may: it can add an owner or enable a module, and an enabled module moves funds with no signature. So one owner key and this co-signer control the Safe's settings. Everything else is refused, by name.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/TeamSafe.sol\":\"PolicyCoSigner\"},\"evmVersion\":\"paris\",\"libraries\":{},\"metadata\":{\"appendCBOR\":false,\"bytecodeHash\":\"none\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[]},\"sources\":{\"src/TeamSafe.sol\":{\"keccak256\":\"0x7f3222b99d7dd0d4f7d5d8c73b43a63c423835a7308f7ca44cafd09805dacf59\",\"license\":\"Apache-2.0\",\"urls\":[\"bzz-raw://49bd52f6278ff59d19d0fe27d521a4eeb94ef6ecfb9e8e8fe946b5df5c771bd3\",\"dweb:/ipfs/QmXM6MfevD88MT2W1hHRFdmwZz5JaGKSqQqq8YTzB277FH\"]}},\"version\":1}","metadata":{"compiler":{"version":"0.8.26+commit.8a97fa7a"},"language":"Solidity","output":{"abi":[{"inputs":[{"internalType":"uint256","name":"value","type":"uint256"}],"type":"error","name":"CarriesValue"},{"inputs":[{"internalType":"address","name":"to","type":"address"}],"type":"error","name":"NotACallToTheSafeItself"},{"inputs":[{"internalType":"uint8","name":"operation","type":"uint8"}],"type":"error","name":"NotAPlainCall"},{"inputs":[{"internalType":"address","name":"caller","type":"address"}],"type":"error","name":"NotAnOwner"},{"inputs":[{"internalType":"uint256","name":"gasPrice","type":"uint256"}],"type":"error","name":"PaysA