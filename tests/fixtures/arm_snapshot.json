 "codex:openrouter/vendor/m": {
  "calls": [
   {
    "argv": [
     "/opt/bin/codex",
     "exec",
     "--json",
     "--skip-git-repo-check",
     "-C",
     "<tmp>/ws",
     "do the task"
    ],
    "cwd": "<tmp>/ws",
    "env": {
     "CODEX_HOME": "<tmp>/codex-home",
     "HOME": "/home/runner",
     "HTTPS_PROXY": "http://127.0.0.1:3128",
     "HTTP_PROXY": "http://127.0.0.1:3128",
     "LITELLM_MODE": "PRODUCTION",
     "OPENROUTER_API_KEY": "<secret>",
     "PATH": "/usr/bin:/bin",
     "PEARL_CONNECT_TOKEN": "<secret>",
     "TEMP": "<tmp>/tmp",
     "TMP": "<tmp>/tmp",
     "TMPDIR": "<tmp>/tmp"
    },
    "timeout": 900,
    "via": "run"
   }
  ],
  "cap": "between turns",
  "files": {
   "codex-home/config.toml": "model = \"vendor/m\"\nmodel_provider = \"openrouter\"\napproval_policy = \"never\"\ncheck_for_update_on_startup = false\nsandbox_mode = \"workspace-write\"\n\n[sandbox_workspace_write]\nnetwork_access = true\nexclude_slash_tmp = true\n\n[model_providers.openrouter]\nname = \"OpenRouter\"\nbase_url = \"https://openrouter.ai/api/v1\"\nenv_key = \"OPENROUTER_API_KEY\"\n\n[mcp_servers.pearl-connect]\nurl = \"http://127.0.0.1:7000/mcp/\"\nbearer_token_env_var = \"PEARL_CONNECT_TOKEN\"\ndefault_tools_approval_mode = \"approve\"\n\n[analytics]\nenabled = false\n\n[feedback]\nenabled = false\n\n[features]\nplugins = false\nremote_plugin = false\nplugin_discovery_prefetch = false\nplugin_sharing = false\napps = false\nin_app_updates = false\n\n[otel]\nexporter = \"none\"\nmetrics_exporter = \"none\"\ntrace_exporter = \"none\"\n\n[shell_environment_policy]\ninherit = \"all\"\nignore_default_excludes = false\n"
  },
  "named_secrets": [
   "the OpenRouter key"
  ],
  "step_limit": "none: codex exec has no turn or step limit"
 },
 "hermes-raw:openrouter/vendor/m": {
  "calls": [
   {
    "argv": [
     "/opt/bin/hermes",
     "chat",
     "--oneshot",
     "-Q",
     "--format",
     "stream-json",
     "--max-turns",
     "500",
     "--yolo",
     "-q",
     "do the task"
    ],
    "cwd": "<tmp>/ws",
    "env": {
     "HERMES_GATEWAY_LOCK_DIR": "<tmp>/hermes-home/gateway-locks",
     "HERMES_HOME": "<tmp>/hermes-home",
     "HOME": "/home/runner",
     "HTTPS_PROXY": "http://127.0.0.1:3128",
     "HTTP_PROXY": "http://127.0.0.1:3128",
     "LITELLM_MODE": "PRODUCTION",
     "OPENROUTER_API_KEY": "<secret>",
     "PATH": "/usr/bin:/bin",
     "TEMP": "<tmp>/tmp",
     "TMP": "<tmp>/tmp",
     "TMPDIR": "<tmp>/tmp"
    },
    "timeout": 900,
    "via": "run"
   },
   {
    "argv": [
     "ps",
     "axeww",
     "-o",
     "pid=,command="
    ],
    "via": "Popen"
   }
  ],
  "cap": "between turns",
  "files": {
   "hermes-home/config.yaml": "agent:\n  disabled_toolsets:\n  - cronjob\n  run_budget_seconds: 840\napprovals:\n  mode: 'off'\nmcp_servers:\n  evm:\n    args:\n    - /opt/evm-mcp/index.js\n    command: node\n    env:\n      EVM_PRIVATE_KEY: 0xk\n      EVM_RPC_STRICT: '1'\n      EVM_RPC_URL: http://127.0.0.1:8545\n      EVM_RPC_URL_100: http://127.0.0.1:8545\nmodel:\n  default: vendor/m\n  provider: openrouter\nmodel_catalog:\n  enabled: false\nmodels_dev:\n  url: http://127.0.0.1:9/\n"
  },
  "named_secrets": [
   "the OpenRouter key"
  ],
  "step_limit": "--max-turns 500, per turn"
 },
