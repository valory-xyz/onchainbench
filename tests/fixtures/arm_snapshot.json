{
 "claude-code": {
  "calls": [
   {
    "argv": [
     "/opt/bin/claude",
     "-p",
     "do the task",
     "--output-format",
     "stream-json",
     "--verbose",
     "--mcp-config",
     "<tmp>/ws/.mcp.json",
     "--strict-mcp-config",
     "--permission-mode",
     "acceptEdits",
     "--allowedTools",
     "Bash",
     "Read",
     "Write",
     "Edit",
     "Glob",
     "Grep",
     "WebFetch",
     "WebSearch",
     "mcp__pearl-connect",
     "--max-turns",
     "500"
    ],
    "cwd": "<tmp>/ws",
    "env": {
     "ANTHROPIC_API_KEY": "<secret>",
     "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
     "HOME": "/home/runner",
     "HTTPS_PROXY": "http://127.0.0.1:3128",
     "HTTP_PROXY": "http://127.0.0.1:3128",
     "LITELLM_MODE": "PRODUCTION",
     "PATH": "/usr/bin:/bin",
     "TEMP": "<tmp>/tmp",
     "TMP": "<tmp>/tmp",
     "TMPDIR": "<tmp>/tmp"
    },
    "timeout": 900,
    "via": "run"
   }
  ],
  "cap": "between turns",
  "files": {},
  "named_secrets": [
   "the Anthropic key"
  ],
  "step_limit": "--max-turns 500, per turn"
 },
