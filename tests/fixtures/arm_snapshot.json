 "openclaw-raw:openrouter/vendor/m": {
  "calls": [
   {
    "argv": [
     "/opt/bin/openclaw",
     "agent",
     "--local",
     "--session-id",
     "ocb-<uuid>",
     "--message-file",
     "<tmp>/openclaw-raw-state/message.md",
     "--model",
     "openrouter/vendor/m",
     "--timeout",
     "840",
     "--json"
    ],
    "cwd": "<tmp>/ws",
    "env": {
     "HOME": "/home/runner",
     "HTTPS_PROXY": "http://127.0.0.1:3128",
     "HTTP_PROXY": "http://127.0.0.1:3128",
     "LITELLM_MODE": "PRODUCTION",
     "OPENCLAW_CONFIG_PATH": "<tmp>/openclaw-raw-state/run.json",
     "OPENCLAW_HOME": "<tmp>/openclaw-raw-state/home",
     "OPENCLAW_STATE_DIR": "<tmp>/openclaw-raw-state/state",
     "PATH": "/usr/bin:/bin",
     "TEMP": "<tmp>/tmp",
     "TMP": "<tmp>/tmp",
     "TMPDIR": "<tmp>/tmp"
    },
    "timeout": 900,
    "via": "run"
   },
   {
    "argv": [
     "/opt/bin/openclaw",
     "sessions",
     "export-trajectory",
     "--session-key",
     "agent:main:explicit:ocb-<uuid>",
     "--workspace",
     "<tmp>/openclaw-raw-state/export",
     "--output",
     "turn-1",
     "--json"
    ],
    "cwd": "<tmp>/openclaw-raw-state",
    "env": {
     "HOME": "/home/runner",
     "HTTPS_PROXY": "http://127.0.0.1:3128",
     "HTTP_PROXY": "http://127.0.0.1:3128",
     "LITELLM_MODE": "PRODUCTION",
     "ONCHAINBENCH_OPENCLAW_RAW_EXPORT": "1",
     "OPENCLAW_CONFIG_PATH": "<tmp>/openclaw-raw-state/run.json",
     "OPENCLAW_HOME": "<tmp>/openclaw-raw-state/home",
     "OPENCLAW_STATE_DIR": "<tmp>/openclaw-raw-state/state",
     "PATH": "/usr/bin:/bin",
     "TEMP": "<tmp>/tmp",
     "TMP": "<tmp>/tmp",
     "TMPDIR": "<tmp>/tmp"
    },
    "timeout": 120,
    "via": "run"
   }
  ],
  "cap": "between turns",
  "files": {
   "openclaw-raw-state/message.md": "do the task",
   "openclaw-raw-state/run.json": "{\"env\": {\"shellEnv\": {\"enabled\": false}}, \"agents\": {\"defaults\": {\"workspace\": \"<tmp>/ws\", \"skipBootstrap\": true, \"sandbox\": {\"mode\": \"off\"}, \"timeoutSeconds\": 840}}, \"mcp\": {\"servers\": {\"evm\": {\"command\": \"node\", \"args\": [\"/opt/evm-mcp/index.js\"], \"env\": {\"EVM_PRIVATE_KEY\": \"0xk\", \"EVM_RPC_URL_100\": \"http://127.0.0.1:8545\", \"EVM_RPC_URL\": \"http://127.0.0.1:8545\", \"EVM_RPC_STRICT\": \"1\"}}}}, \"tools\": {\"profile\": \"coding\", \"fs\": {\"workspaceOnly\": true}, \"exec\": {\"mode\": \"full\"}, \"loopDetection\": {\"enabled\": true}, \"deny\": [\"group:automation\", \"ask_user\", \"sessions_spawn\", \"subagents\", \"agents_wait\"]}, \"skills\": {\"load\": {\"watch\": false}}, \"models\": {\"providers\": {\"openrouter\": {\"apiKey\": \"<secret>\"}}}}"
  },
  "named_secrets": [
   "the OpenRouter key"
  ],
  "step_limit": "none: openclaw agent has no turn limit (its turn timeout and loop detection apply)"
 },
