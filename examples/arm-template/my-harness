#!/usr/bin/env python3
"""A stand-in harness CLI that meets OnchainBench's CLI contract (CONTRIBUTING.md, "The CLI contract").

    my-harness --dir <workspace> --model <model> --step-limit N --cost-limit USD --output json [--resume ID] -p TASK

It "answers" by reversing the task text, so the session class in my_harness_arm.py can be tried without a model.
A real harness runs its agent here, in the workspace, and prints the same JSON object on stdout:
  reply, session_id, error ("provider", "harness", "timeout" or null), model_calls, prompt_tokens,
  completion_tokens and cost_usd (session totals, kept across --resume), and events (this turn's messages, in the
  OpenAI chat shape).
"""

import argparse
import json
import uuid
from pathlib import Path

ap = argparse.ArgumentParser(prog="my-harness")
ap.add_argument("--dir", type=Path, required=True)
ap.add_argument("--model", required=True)
ap.add_argument("--step-limit", type=int, default=500)
ap.add_argument("--cost-limit", type=float, default=2.0)
ap.add_argument("--output", choices=["json"], default="json")
ap.add_argument("--resume")
ap.add_argument("-p", dest="prompt", required=True)
a = ap.parse_args()

state = a.dir.parent / "my-harness-state"  # a real harness keeps its sessions where the arm tells it to
state.mkdir(exist_ok=True)
sid = a.resume or uuid.uuid4().hex[:8]
f = state / f"{sid}.json"
totals = json.loads(f.read_text()) if f.exists() else {"model_calls": 0, "prompt_tokens": 0, "completion_tokens": 0}
reply = a.prompt[::-1]
totals = {
    "model_calls": totals["model_calls"] + 1,
    "prompt_tokens": totals["prompt_tokens"] + len(a.prompt),
    "completion_tokens": totals["completion_tokens"] + len(reply),
}
f.write_text(json.dumps(totals))
events = [{"role": "user", "content": a.prompt}, {"role": "assistant", "content": reply}]
print(json.dumps({"reply": reply, "session_id": sid, "error": None, "cost_usd": 0.0, "events": events, **totals}))
